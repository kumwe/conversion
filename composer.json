{
  "name": "kumwe/conversion",
  "description": "The money and quantity conversion contract of the Kumwe family: the exact decimal kernel, typed money and quantity values, converted values that always carry their rate and as-at instant, and the provider ports rate and unit extensions implement. Core ships no rate and no conversion table.",
  "type": "library",
  "license": "Apache-2.0",
  "homepage": "https://github.com/kumwe/conversion",
  "support": {
    "issues": "https://github.com/kumwe/conversion/issues",
    "source": "https://github.com/kumwe/conversion"
  },
  "require": {
    "php": "^8.5"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "squizlabs/php_codesniffer": "^4.0",
    "ext-zip": "*"
  },
  "autoload": {
    "psr-4": {
      "Kumwe\\Conversion\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kumwe\\Conversion\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "composer:validate": "composer validate --strict",
    "lint": "php tools/lint.php",
    "docs": "php tools/check-docblocks.php",
    "api": "php tools/verify-public-api.php",
    "api:record": "php tools/verify-public-api.php --write",
    "autoload:smoke": "php resources/toolchain/autoload-smoke.php",
    "cs": "phpcs -q",
    "cs:fix": "phpcbf",
    "analyse": "phpstan analyse --no-progress --memory-limit=1G",
    "test": "php tests/run.php",
    "check": [
      "@composer:validate",
      "@lint",
      "@docs",
      "@architecture",
      "@api",
      "@schemas",
      "@metadata",
      "@api:docs",
      "@autoload:smoke",
      "@cs",
      "@analyse",
      "@test:ownership",
      "@test",
      "@release-record",
      "@release:integrity",
      "@archive:test",
      "@clean-consumer"
    ],
    "test:ownership": "php tools/verify-test-ownership.php --self-test",
    "architecture": "php tools/verify-architecture.php",
    "release-record": "bash tools/test-release-record.sh",
    "release:integrity": "bash tools/test-release-integrity.sh",
    "metadata": "php tools/verify-v2-metadata.php",
    "api:docs": "php tools/render-public-api-docs.php",
    "clean-consumer": "php tools/verify-clean-consumer.php",
    "archive:test": "php tools/test-archive.php",
    "schemas": "node tools/schema-validator/verify.cjs"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
